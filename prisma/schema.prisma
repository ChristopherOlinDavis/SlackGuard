generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id                  String              @id @default(uuid())
  teamId              String              @unique
  name                String
  accessToken         String              // Encrypted with AES-256-GCM
  adminEmail          String?             // Email for drift alerts and notifications

  // Subscription Management
  subscriptionTier    SubscriptionTier    @default(FREE)
  subscriptionStatus  SubscriptionStatus  @default(ACTIVE)
  hasUsedFreeScan     Boolean             @default(false)
  stripeCustomerId    String?             // Stripe customer ID for billing

  installedApps       InstalledApp[]
  riskAudits          RiskAudit[]
  scanHistory         ScanHistory[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model InstalledApp {
  id             String         @id @default(uuid())
  workspaceId    String
  workspace      Workspace      @relation(fields: [workspaceId], references: [id])

  appId          String         // Slack App ID or Service ID
  appName        String
  serviceType    String?        // Distinguishes Integrations vs Apps

  scopes         String[]       // Array of granted scopes
  isClassic      Boolean        // TRUE if scopes contains 'bot'

  addedAt        DateTime       // Timestamp from logs
  status         AppStatus      @default(ACTIVE)

  @@unique([workspaceId, appId]) // Idempotency constraint
}

model RiskAudit {
  id             String      @id @default(uuid())
  workspaceId    String
  workspace      Workspace   @relation(fields: [workspaceId], references: [id])

  idempotencyKey String      @unique // Format: "ws_{id}_{date}"

  classicCount   Int
  modernCount    Int

  scanDate       DateTime    @default(now())
}

model ScanHistory {
  id             String      @id @default(uuid())
  workspaceId    String
  workspace      Workspace   @relation(fields: [workspaceId], references: [id])

  classicCount   Int
  modernCount    Int
  totalApps      Int

  // Track changes from previous scan
  newClassicApps    String[]  @default([])  // App IDs of newly detected classic apps
  removedApps       String[]  @default([])  // App IDs of apps that were removed
  scopeChanges      Json?                   // Track apps whose scopes changed

  scanDate       DateTime    @default(now())

  @@index([workspaceId, scanDate])
}

enum AppStatus {
  ACTIVE
  REMOVED
}

enum SubscriptionTier {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  TRIAL
}
