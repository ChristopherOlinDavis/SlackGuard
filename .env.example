# Database
DATABASE_URL="postgresql://user:password@localhost:5432/slackguard?schema=public"

# ============================================================================
# REQUIRED FOR PRODUCTION
# ============================================================================

# Encryption (REQUIRED for token security)
# Generate a 32-byte (64-character hex) key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="your_64_character_hex_string_here"

# Slack OAuth (REQUIRED for workspace authentication)
# Get these from https://api.slack.com/apps
# Required scopes: admin.integrations:read, team:read
SLACK_CLIENT_ID="xxx.xxx"
SLACK_CLIENT_SECRET="xxx"
SLACK_REDIRECT_URI="https://yourdomain.com/auth/slack/callback"
SLACK_SIGNING_SECRET="xxx"

# Email Service (REQUIRED for drift alerts and notifications)
# Resend (recommended - easiest setup)
RESEND_API_KEY="re_xxx"
FROM_EMAIL="SlackGuard <alerts@yourdomain.com>"
SUPPORT_EMAIL="support@yourdomain.com"

# Stripe (REQUIRED for PRO subscriptions)
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_live_xxx"
STRIPE_PUBLISHABLE_KEY="pk_live_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
STRIPE_PRICE_ID_PRO="price_xxx"  # Create recurring price in Stripe Dashboard

# ============================================================================
# OPTIONAL SERVICES
# ============================================================================

# Session & Security
SESSION_SECRET="your-secret-key-here-min-32-chars"

# Monitoring (for cron job authentication)
MONITORING_SECRET_TOKEN="your-monitoring-secret-token"

# Alternative Email Services (use if not using Resend)
# SendGrid
# SENDGRID_API_KEY="SG.xxx"
# AWS SES
# AWS_ACCESS_KEY_ID="xxx"
# AWS_SECRET_ACCESS_KEY="xxx"
# AWS_REGION="us-east-1"

# Application
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Optional: Redis (for caching)
REDIS_URL="redis://localhost:6379"

# Optional: Sentry (error tracking)
SENTRY_DSN="https://xxx@sentry.io/xxx"
